#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors/rgbled_widget.dtsi>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define MOUSE  1
#define LOWER  2
#define RAISE  3
#define SLOW   4
#define ADJUST 5
#define EDIT   6

// US symbols on a Japanese keyboard layout.

#define JP_AT        LEFT_BRACKET
#define JP_CARET     EQUAL
#define JP_AMPERSAND CARET
#define JP_ASTERISK  DOUBLE_QUOTES
#define JP_DQUOTE    AT
#define JP_EQUAL     UNDER
#define JP_PLUS      COLON
#define JP_TILDE     PLUS
#define JP_PIPE      LS(INTERNATIONAL_3)
#define JP_COLON     SINGLE_QUOTE
#define JP_QUOTE     AMPERSAND
#define JP_BACKQUOTE LEFT_BRACE
#define JP_BSLASH    INTERNATIONAL_1
#define JP_UNDERSCORE LS(INTERNATIONAL_1)
#define JP_LBRACKET  RIGHT_BRACKET
#define JP_RBRACKET  BACKSLASH
#define JP_LPAREN    ASTERISK
#define JP_RPAREN    LEFT_PARENTHESIS
#define JP_LBRACE    RIGHT_BRACE
#define JP_RBRACE    PIPE
#define JP_KANA      LANGUAGE_1
#define JP_EISU      LANGUAGE_2

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <175>;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
#if defined(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
    inertial_scroll: inertial_scroll {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <1>;
        layer = <LOWER>;
        scale = <4>;
        scale-div = <675>;
    };

    inertial_hscroll: inertial_hscroll {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <2>;
        layer = <RAISE>;
        scale = <4>;
        scale-div = <675>;
    };
#endif

    mouse_temp_layer: mouse_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <300>;
        excluded-positions = <16>;
    };
};

&trackball_listener {
    input-processors = <&zip_mouse_gesture &mouse_temp_layer MOUSE 500>;

    vertical_scroller {
        layers = <LOWER>;
        input-processors = <
            &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
            &zip_x_scaler 0 1
            &zip_xy_to_scroll_mapper
#if defined(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
            &inertial_scroll
#endif
            &zip_scroll_scaler 4 675
        >;
    };

    horizontal_scroller {
        layers = <RAISE>;
        input-processors = <
            &zip_y_scaler 0 1
            &zip_xy_to_scroll_mapper
#if defined(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
            &inertial_hscroll
#endif
            &zip_scroll_scaler 4 675
        >;
    };

    slow_cursor {
        layers = <SLOW>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&zip_mouse_gesture {
    stroke-size = <100>;
    enable-eager-mode;

    win1 {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(N1)>;
    };

    win2 {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(N2)>;
    };

    win3 {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(N3)>;
    };

    win4 {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(N4)>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankakuEdit {
            timeout-ms = <50>;
            bindings = <&edit_ime EDIT GRAVE>;
            key-positions = <34 37>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <7 8>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 26>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <27 28>;
        };

        colon {
            timeout-ms = <50>;
            bindings = <&jm_colon>;
            key-positions = <28 29>;
        };

        quote {
            timeout-ms = <50>;
            bindings = <&jm_quote>;
            key-positions = <39 40>;
        };

        tilde {
            timeout-ms = <50>;
            bindings = <&jm_tilde>;
            key-positions = <18 19>;
        };

        plus {
            timeout-ms = <50>;
            bindings = <&jm_plus>;
            key-positions = <8 9>;
        };

        left_parenthesis {
            timeout-ms = <50>;
            bindings = <&kp JP_LPAREN>;
            key-positions = <2 3>;
        };

        right_parenthesis {
            timeout-ms = <50>;
            bindings = <&kp JP_RPAREN>;
            key-positions = <6 7>;
        };

        parenthesis_pair {
            timeout-ms = <50>;
            bindings = <&type_parens>;
            key-positions = <2 3 6 7>;
        };

        bracket_pair {
            timeout-ms = <50>;
            bindings = <&type_brackets>;
            key-positions = <38 39>;
        };

        f2 {
            bindings = <&macro_f2_kana>;
            key-positions = <13 12>;
        };

        double_left_click {
            timeout-ms = <50>;
            bindings = <&double_lclick>;
            key-positions = <16 17>;
        };

        shift_right_click {
            timeout-ms = <50>;
            bindings = <&shift_rclick>;
            key-positions = <16 17 18>;
        };

        ctrl_left_click {
            timeout-ms = <50>;
            bindings = <&ctrl_lclick>;
            key-positions = <16 18>;
        };

        mouse_gesture {
            timeout-ms = <50>;
            bindings = <&mouse_gesture>;
            key-positions = <18 19>;
        };

        parens_fj {
            timeout-ms = <50>;
            bindings = <&type_parens>;
            key-positions = <13 16>;
        };

        new_folder {
            timeout-ms = <50>;
            bindings = <&kp LS(LC(N))>;
            key-positions = <11 12>;
        };

        exclamation_aenter {
            timeout-ms = <50>;
            bindings = <&kp LS(N1)>;
            key-positions = <10 34>;
        };

        at_senter {
            timeout-ms = <50>;
            bindings = <&kp JP_AT>;
            key-positions = <11 34>;
        };

        ab3233921 {
            timeout-ms = <50>;
            bindings = <&type_ab3233921>;
            key-positions = <10 24>;
        };

        alt+f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <12 13 34>;
        };

        win+d {
            bindings = <&kp LG(D)>;
            key-positions = <12 34>;
        };

        task_viewer {
            bindings = <&kp LG(TAB)>;
            key-positions = <13 34>; // F + Enter
        };

        alt+tab {
            bindings = <&kp LA(TAB)>;
            key-positions = <13 35>;
        };

        adjust_layer {
            timeout-ms = <200>;
            slow-release;
            bindings = <&mo ADJUST>;
            key-positions = <35 36>;
        };

        alt+f4_right {
            bindings = <&kp LA(F4)>;
            key-positions = <16 17 37>;
        };

        alt+tab_right {
            bindings = <&kp LA(TAB)>;
            key-positions = <16 36>;
        };

        task {
            bindings = <&kp LG(TAB)>;
            key-positions = <16 37>;
        };

        win+d_right {
            bindings = <&kp LG(D)>;
            key-positions = <17 37>;
        };
    };

    behaviors {
        battery_text: battery_text {
            compatible = "zmk,behavior-battery-text";
            #binding-cells = <0>;
            display-name = "Battery Text";
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        numht: number_function_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        jm_n2: japanese_number_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F2 N2>, <&kp JP_AT>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_n6: japanese_number_6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F6 N6>, <&kp JP_CARET>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_n7: japanese_number_7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F7 N7>, <&kp JP_AMPERSAND>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_n8: japanese_number_8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F8 N8>, <&kp JP_ASTERISK>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_n9: japanese_number_9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F9 N9>, <&kp JP_LPAREN>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_n0: japanese_number_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&numht F10 N0>, <&kp JP_RPAREN>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_minus: japanese_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp INTERNATIONAL_1>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
            keep-mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_lbkt: japanese_left_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_LBRACKET>, <&kp JP_LBRACE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_rbkt: japanese_right_bracket {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_RBRACKET>, <&kp JP_RBRACE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_plus: japanese_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_PLUS>, <&kp JP_EQUAL>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_tilde: japanese_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_TILDE>, <&kp JP_BACKQUOTE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_colon: japanese_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp JP_COLON>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_quote: japanese_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_QUOTE>, <&kp JP_DQUOTE>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        jm_question: japanese_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp QUESTION>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        edit_ime: edit_ime {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        jm_pipe: japanese_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp JP_PIPE>, <&kp JP_BSLASH>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        minus_lt: japanese_minus_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&jm_minus>;
        };

        lbkt_lt: japanese_left_bracket_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&jm_lbkt>;
        };

        question_mt: japanese_question_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&jm_question>;
        };

        pipe_mt: japanese_pipe_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&jm_pipe>;
        };

        raise_ime: raise_ime {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&raise_ime_hold>, <&kp>;
        };

        slow_eisu_tap: slow_eisu_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&slow_eisu_hold>, <&kp>;
        };

        slow_minus_base: slow_minus_base {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&slow_eisu_hold>, <&kp>;
        };

        slow_minus: slow_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&slow_minus_base 0 MINUS>, <&kp INTERNATIONAL_1>;

            mods = <(MOD_LSFT | MOD_RSFT)>;
            keep-mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    macros {
        double_lclick: double_lclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap>, <&mkp MB1 &mkp MB1>;
        };

        shift_rclick: shift_rclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&mkp MB2>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        type_parens: type_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_KANA &kp JP_LPAREN &kp JP_RPAREN &kp ENTER &kp LEFT>;
        };

        type_brackets: type_brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_KANA &kp JP_LBRACKET &kp JP_RBRACKET &kp ENTER &kp LEFT>;
        };

        type_00: type_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_EISU &kp KP_NUMBER_0 &kp KP_NUMBER_0>;
        };

        num_eisu: num_eisu {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_EISU &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;
        };

        ctrl_lclick: ctrl_lclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&mkp MB1>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        macro_f2_kana: macro_f2_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap>, <&kp F2 &kp JP_KANA>;
        };

        type_ab3233921: type_ab3233921 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_tap>,
                <&kp JP_EISU &kp A &kp B &kp N3 &kp N2 &kp N3 &kp N3 &kp N9 &kp N2 &kp N1>;
        };

        raise_ime_hold: raise_ime_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&mo RAISE>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo RAISE>,
                <&macro_tap>,
                <&kp JP_KANA>;
        };

        slow_eisu_hold: slow_eisu_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&mo SLOW>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SLOW>,
                <&macro_tap>,
                <&kp JP_EISU>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q          &mt LC(W) W   &kp E                       &mt LC(R) R         &mt LC(T) T                                           &mt LC(Y) Y         &mt LC(U) U  &mt LC(I) I  &kp O           &mt LC(P) P
&mt LC(A) A    &mt LC(S) S   &mt LC(D) D                 &mt LEFT_ALT F      &kp G                                                 &mt LC(H) H         &kp J        &lt LOWER K  &raise_ime 0 L  &slow_minus
&mt LC(Z) Z    &mt LC(X) X   &mt LC(C) C                 &mt LC(V) V         &mt LC(B) B                                           &mt LC(N) N         &kp M        &kp COMMA    &kp DOT         &question_mt RCTRL 0
&mt LCTRL ESC  &kp LEFT_WIN  &slow_eisu_tap 0 LG(LS(S))  &raise_ime 0 GRAVE  &lt LOWER ENTER  &mt LEFT_SHIFT TAB    &kp BACKSPACE  &raise_ime 0 SPACE               &jm_lbkt     &jm_rbkt        &pipe_mt RIGHT_ALT 0
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //2

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans      &kp LC(LS(TAB))  &kp LC(W)   &kp LC(TAB)  &kp LC(T)                                        &trans         &trans             &kp UP    &trans               &trans
&kp LG(N1)  &kp LG(N2)       &kp LG(N3)  &kp LG(N4)   &kp LG(N5)                                       &trans         &mt LG(LEFT) LEFT  &kp DOWN  &mt LG(RIGHT) RIGHT  &trans
&kp LC(N1)  &kp LC(N2)       &kp LC(N3)  &kp LC(N4)   &kp LC(N5)                                       &trans         &kp LG(LS(LEFT))   &trans    &kp LS(LG(RIGHT))    &trans
&trans      &trans           &trans      &trans       &trans      &trans    &mt LA(LC(DELETE)) DELETE  &kp LS(SPACE)                     &trans    &trans               &trans
            >;

            sensor-bindings = <&re_kp LS(RIGHT) LS(LEFT)>;
        };

        //3

        raise_layer {
            display-name = "Raise";
            bindings = <
&num_eisu KP_PLUS      &num_eisu KP_NUMBER_7  &num_eisu KP_NUMBER_8  &num_eisu KP_NUMBER_9  &num_eisu KP_SLASH                            &trans  &trans  &trans  &trans  &trans
&trans                 &num_eisu KP_NUMBER_4  &num_eisu KP_NUMBER_5  &num_eisu KP_NUMBER_6  &num_eisu KP_MULTIPLY                         &trans  &kp F7  &kp F8  &kp F9  &kp F10
&num_eisu KP_NUMBER_0  &num_eisu KP_NUMBER_1  &num_eisu KP_NUMBER_2  &num_eisu KP_NUMBER_3  &num_eisu KP_MINUS                            &trans  &trans  &trans  &trans  &trans
&trans                 &num_eisu KP_NUMBER_0  &num_eisu KP_DOT       &type_00               &num_eisu KP_ENTER     &kp LS(TAB)    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&re_kp C_VOL_DN C_VOL_UP>;
        };

        //4

        slow_layer {
            display-name = "Slow";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &trans          &trans  &trans  &trans  &bt BT_CLR_ALL
&battery_text  &none         &none         &none         &none                                &out OUT_TOG    &none   &none   &none   &bt BT_CLR
&none          &none         &none         &none         &none                                &none           &none   &none   &none   &none
&trans         &kp C_MUTE    &trans        &trans        &trans        &trans    &bootloader  &studio_unlock          &trans  &trans  &trans
            >;

            sensor-bindings = <&re_kp C_VOL_UP C_VOL_DN>;
        };

        //6

        edit_layer {
            display-name = "Edit";
            bindings = <
&trans      &trans     &trans      &trans      &trans                        &trans        &trans            &trans           &trans         &trans
&kp N1      &kp N2     &kp N3      &kp N4      &kp N5                        &kp N6        &kp N7            &kp N8           &kp N9         &kp N0
&kp LS(N1)  &kp JP_AT  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                    &kp JP_CARET  &kp JP_AMPERSAND  &kp JP_ASTERISK  &kp JP_LPAREN  &kp JP_RPAREN
&trans      &trans     &trans      &trans      &trans      &trans    &trans  &trans                          &trans           &trans         &trans
            >;
        };
    };
};
